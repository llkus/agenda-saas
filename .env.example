FLASK_APP=run.py
FLASK_ENV=development

# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Connection string do Postgres do Supabase (Direct connection, porta 5432)
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<database>
# Se a senha tiver caracteres especiais (#, @, etc), faça percent-encode:
# # -> %23, @ -> %40
DATABASE_URL=postgresql://postgres:senha@db.xxxxxxxxxxxx.supabase.co:5432/postgres
